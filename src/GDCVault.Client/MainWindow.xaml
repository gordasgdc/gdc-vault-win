<ui:FluentWindow x:Class="GDCVault.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:GDCVault.Client"
        Title="GDC Vault" Height="640" Width="1000" MinWidth="820" MinHeight="480"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <!--
      ARHITECTURA UI (rescrisa 2026-08-24, la cererea lui Cristi): sidebar
      stanga cu actiunile PRINCIPALE vizibile direct (nu ascunse intr-un
      meniu) - Adauga/Export/Import deasupra listei - si fisa completa a
      produsului selectat in dreapta. Vezi ContentView.swift (Mac) pentru
      oglinda SwiftUI a aceleiasi structuri.
    -->
    <!-- x:Name RootGrid (Regula 24) - tinta lui ApplyTextScale() din
         code-behind: LayoutTransform aplicat aici scaleaza UNIFORM tot
         continutul ferestrei, fara sa umblam prin fiecare FontSize
         hardcodat din XAML. -->
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BUG FIX 2026-08-27 (raportat de Cristi: "fereastra ramane
             fixa, nu o pot deplasa/muta pe ecran"): FluentWindow inlocuieste
             chrome-ul nativ Windows cu WindowChrome propriu si NU ofera
             nicio zona de drag/butoane minimize-maximize-close fara un
             <ui:TitleBar> explicit - lipsea complet din acest fisier de la
             inceput (bug pre-existent, scos la iveala abia acum de primul
             test real pe Windows, nu de o schimbare din aceasta sesiune). -->
        <ui:TitleBar Grid.Row="0" Title="GDC Vault" Icon="pack://application:,,,/Assets/app.ico" />

        <!-- Banner de proba/licenta — vizibil mereu cat timp NU exista o
             licenta activa (LicenseManager.IsLicensed). NU blocheaza nimic
             singur — gating-ul real e pe butonul "+ Adauga aplicatie". -->
        <Border Grid.Row="1" x:Name="TrialBanner" Background="{DynamicResource TrialBannerSurfaceBrush}" Padding="14,6" Visibility="Collapsed">
            <DockPanel>
                <ui:Button x:Name="DonateButton" Content="Donează pentru licență" Appearance="Transparent" Foreground="{DynamicResource DonateAccentBrush}"
                           DockPanel.Dock="Right" Click="OnActivateClicked" />
                <TextBlock x:Name="TrialBannerText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="480" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <!-- rand nou (v0.7.0): bara de cost total -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="14">
                <TextBlock Text="GDC Vault" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <ui:Button Content="+ Adaugă aplicație" Appearance="Primary"
                           HorizontalContentAlignment="Left" Margin="0,0,0,8"
                           Click="OnAddClicked" />
                <UniformGrid Columns="2">
                    <ui:Button Content="Export" Icon="{ui:SymbolIcon ArrowUpload24}" Margin="0,0,4,0" Click="OnExportClicked" />
                    <ui:Button Content="Import" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="4,0,0,0" Click="OnImportClicked" />
                </UniformGrid>

                <!-- Cautare fuzzy globala (2026-08-27) - Nume, URL login,
                     Notite, Resurse si asset-uri cumparate. Vezi FuzzySearch.cs.
                     ui:TextBox simplu (nu AutoSuggestBox) - extinde direct
                     System.Windows.Controls.TextBox, deci TextChanged e
                     evenimentul standard TextChangedEventHandler, fara
                     ambiguitate de semnatura. -->
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="12" Margin="6,0,4,0" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="Caută aplicație, asset, notiță, serie…"
                                TextChanged="OnSearchTextChanged" />
                </DockPanel>
            </StackPanel>

            <Border Grid.Row="1" x:Name="ExpiringBanner" Background="{DynamicResource ExpiringBannerSurfaceBrush}" CornerRadius="6"
                    Padding="10" Margin="14,0,14,10" Visibility="Collapsed">
                <TextBlock x:Name="ExpiringBannerText" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarningBrush}" FontSize="12" />
            </Border>

            <ListView Grid.Row="2" x:Name="EntriesList" BorderThickness="0"
                      SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Copiere rapida direct din lista, fara sa deschizi fisa. -->
                                <ui:Button Padding="4,2" Margin="0,0,4,0" Appearance="Transparent"
                                           Click="OnCopyUsernameFromList" Tag="{Binding}"
                                           ToolTip="Copiază utilizatorul"
                                           Visibility="{Binding HasUsername, Converter={StaticResource BoolToVisibility}}">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="14" />
                                </ui:Button>
                                <ui:Button Padding="4,2" Margin="0,0,4,0" Appearance="Transparent"
                                           Click="OnCopyPasswordFromList" Tag="{Binding}"
                                           ToolTip="Copiază parola (clipboard-ul se golește în 45 s)"
                                           Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibility}}">
                                    <ui:SymbolIcon Symbol="Key24" FontSize="14" />
                                </ui:Button>

                                <Border CornerRadius="9" Padding="6,2"
                                        Background="{Binding ExpiryBadgeBrushKey, Converter={StaticResource KeyToBrush}}"
                                        Visibility="{Binding ShowsExpiryBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ExpiryBadgeText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnAccentTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="3" x:Name="MonthlyTotalBar" Padding="12,4" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Cost abonamente" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="MonthlyTotalText" HorizontalAlignment="Right" FontSize="11"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <!-- Profil Utilizator opțional (vezi CLAUDE.md, Partea 1,
                 Regula 12) - Nume/Anonim + Email + Machine ID (cu Copy
                 rapid) + Status Licenta/buton Activeaza, port 1:1 al
                 ProfileSidebarBlock.swift (Mac, actualizat 2026-08-27). -->
            <StackPanel Grid.Row="4" Margin="14,4,14,4">
                <Button Click="OnProfileClicked" Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left" Padding="0" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock x:Name="ProfileNameText" FontSize="11" FontWeight="Medium" />
                        <TextBlock x:Name="ProfileEmailText" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <DockPanel Margin="0,2,0,0">
                    <ui:Button x:Name="CopyMachineIdButton" DockPanel.Dock="Right" Content="⧉" FontSize="9"
                               Padding="4,0" Appearance="Transparent" Click="OnCopyMachineIdClicked"
                               ToolTip="Copiază Machine ID" />
                    <TextBlock x:Name="ProfileMachineIdText" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel Margin="0,2,0,0">
                    <ui:Button x:Name="ActivateLicenseButton" DockPanel.Dock="Right" Content="Activează" FontSize="9.5"
                               Padding="4,0" Appearance="Transparent" Foreground="{DynamicResource StatusSuccessBrush}" Click="OnActivateClicked"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="LicenseStatusText" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>

            <!-- Versiune mereu vizibila in UI + acces direct la verificarea
                 de actualizari, fara sa treci prin meniu - Directiva
                 Permanenta Suprema (vezi CLAUDE.md). -->
            <DockPanel Grid.Row="5" Margin="14,8,14,10">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Left" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <ui:Button DockPanel.Dock="Right" Content="⚙" Appearance="Transparent" Padding="4,0"
                           FontSize="11" Click="OnSettingsClicked" ToolTip="Setări" />
                <ui:Button DockPanel.Dock="Right" Content="Caută actualizări" Appearance="Transparent"
                           FontSize="10.5" HorizontalAlignment="Right" Click="OnCheckForUpdatesClicked" />
            </DockPanel>
        </Grid>

        <!-- Splitter redimensionabil intre sidebar si detaliu (2026-08-27,
             cerinta UX explicita — echivalent al drag pe NavigationSplitView
             de pe Mac, care e deja redimensionabil nativ). -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="True" />

        <!-- Detaliu -->
        <Grid Grid.Column="2">
            <ContentControl x:Name="DetailHost" />
            <TextBlock x:Name="EmptyStateText" Text="Selectează o aplicație din stânga, sau adaugă una nouă."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
