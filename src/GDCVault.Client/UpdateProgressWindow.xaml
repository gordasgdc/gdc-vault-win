<Window x:Class="GDCVault.Client.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizare"
        Width="380" SizeToContent="Height" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <!-- Fereastra minimala de progres pentru self-update (2026-08-27) -
         Window simplu (NU ui:FluentWindow - fara nevoie de TitleBar/drag
         pe o fereastra tranzitorie fara chrome custom), pereche a
         UpdateProgressWindow din GDCPluginManagerWin. -->
    <StackPanel Margin="20,18">
        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" FontSize="11" Margin="0,6,0,12"
                   Foreground="Gray" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" Height="4" />
    </StackPanel>
</Window>
