<ui:FluentWindow x:Class="GDCVault.Client.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Parolă" Height="180" Width="360"
        WindowStartupLocation="CenterOwner">
    <!-- BUG FIX 2026-08-27: FluentWindow fara <ui:TitleBar> nu poate fi
         deplasata/mutata pe ecran (vezi MainWindow.xaml pentru detalii). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Parolă" ShowMaximize="False" ShowMinimize="False" CanMaximize="False" />
    <StackPanel Grid.Row="1" Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <PasswordBox x:Name="PasswordField" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Anulează" Click="OnCancelClicked" Margin="0,0,8,0" />
            <ui:Button Content="OK" Appearance="Primary" Click="OnOkClicked" />
        </StackPanel>
    </StackPanel>
    </Grid>
</ui:FluentWindow>
