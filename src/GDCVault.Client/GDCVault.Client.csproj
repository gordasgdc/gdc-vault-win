<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permite dotnet restore/build sa rezolve TFM-ul windows si de pe macOS -
         vezi acelasi comentariu in GDCPluginManagerWin/GDCPluginManager.Client.csproj.
         Nu inlocuieste un build real pe Windows (XAML->BAML). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GDCVault.Client</RootNamespace>
    <AssemblyName>GDCVault</AssemblyName>
    <!-- Acelasi numar de versiune ca varianta Mac, la fel ca GDCPluginManager. -->
    <Version>0.5.4</Version>
    <!-- Iconita exe-ului (Assets\app.ico - generata din acelasi master 1024px
         ca AppIcon.icns de pe Mac, ca cei doi clienti sa aiba acelasi logo:
         seif stilizat, neon cyan/violet pe ardezie). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GDCVault.Core\GDCVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Acelasi fisier, expus si ca Resource WPF (pack URI), pentru
         Window.Icon (title bar/taskbar la runtime) - ApplicationIcon de mai
         sus seteaza doar iconita exe-ului in Explorer. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ghidul PDF (RO/EN/ES) trebuie accesibil DIN aplicatia rulata
         (Setari > Ghid) - vezi HelpGuide.cs si generate_pdf.py
         (2026-08-27, cerinta Cristi: "nu gasesc PDF-ul"). Copiat langa
         exe la fiecare build/publish; `[Files]` din installer.iss preia
         automat orice fisier din publish\, deci ajunge si in installer. -->
    <Content Include="..\..\installer\Instructiuni_Utilizare.pdf" CopyToOutputDirectory="PreserveNewest" Link="Instructiuni_Utilizare.pdf" />
  </ItemGroup>

</Project>
