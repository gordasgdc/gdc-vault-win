<ui:FluentWindow x:Class="GDCVault.Client.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Intrare Vault" Height="480" Width="380"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Tip" Margin="0,0,0,4" />
        <ComboBox x:Name="KindCombo" SelectionChanged="OnKindChanged" Margin="0,0,0,10" />

        <TextBlock Text="Nume" Margin="0,0,0,4" />
        <ui:TextBox x:Name="NameBox" Margin="0,0,0,10" />

        <CheckBox x:Name="HasExpiryCheck" Content="Are dată de expirare" Checked="OnExpiryToggled" Unchecked="OnExpiryToggled" Margin="0,0,0,6" />
        <DatePicker x:Name="ExpiryPicker" Margin="0,0,0,10" />

        <StackPanel x:Name="CredentialFields" Margin="0,0,0,10">
            <TextBlock Text="URL login" Margin="0,0,0,4" />
            <ui:TextBox x:Name="LoginUrlBox" Margin="0,0,0,8" />
            <TextBlock Text="Utilizator" Margin="0,0,0,4" />
            <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,8" />
            <TextBlock Text="Parolă (gol = nu schimba)" Margin="0,0,0,4" />
            <PasswordBox x:Name="SecretBox" />
        </StackPanel>

        <StackPanel x:Name="LicenseFields" Margin="0,0,0,10">
            <TextBlock Text="Link descărcare" Margin="0,0,0,4" />
            <ui:TextBox x:Name="DownloadUrlBox" Margin="0,0,0,8" />
            <TextBlock Text="Link actualizări" Margin="0,0,0,4" />
            <ui:TextBox x:Name="UpdateUrlBox" Margin="0,0,0,8" />
            <TextBlock Text="Cheie de serie (gol = nu schimba)" Margin="0,0,0,4" />
            <PasswordBox x:Name="LicenseSecretBox" />
        </StackPanel>

        <TextBlock Text="Notițe" Margin="0,0,0,4" />
        <ui:TextBox x:Name="NotesBox" AcceptsReturn="True" Height="60" Margin="0,0,0,10" />

        <TextBlock Text="Atașamente (contracte, facturi, screenshot-uri)" Margin="0,0,0,4" />
        <ListBox x:Name="AttachmentsList" Height="70" Margin="0,0,0,4" MouseDoubleClick="OnAttachmentDoubleClick" />
        <DockPanel Margin="0,0,0,14">
            <ui:Button Content="Șterge atașament" Click="OnRemoveAttachmentClicked" DockPanel.Dock="Right" />
            <ui:Button Content="Adaugă fișier…" Click="OnAddAttachmentClicked" />
        </DockPanel>

        <DockPanel>
            <ui:Button Content="Șterge" Appearance="Danger" Click="OnDeleteClicked" x:Name="DeleteButton" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <ui:Button Content="Anulează" Click="OnCancelClicked" Margin="0,0,8,0" />
                <ui:Button Content="Salvează" Appearance="Primary" Click="OnSaveClicked" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</ui:FluentWindow>
