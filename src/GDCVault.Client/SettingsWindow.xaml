<ui:FluentWindow x:Class="GDCVault.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Setări" Height="420" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <!--
      Panou de Setari (2026-08-27, cerinta Cristi: "nu vad unde sunt
      setari") - tema System/Dark/Light explicita + acces direct la
      Ghidul de Utilizare PDF, altfel invizibil din UI-ul rulat.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BUG FIX 2026-08-27: FluentWindow fara <ui:TitleBar> nu poate fi
             deplasata/mutata pe ecran (vezi MainWindow.xaml pentru detalii). -->
        <ui:TitleBar Grid.Row="0" Title="Setări" ShowMaximize="False" ShowMinimize="False" CanMaximize="False" />

    <StackPanel Grid.Row="1" Margin="20">
        <TextBlock Text="Setări" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <ui:CardExpander Header="Aspect" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel Margin="4">
                <TextBlock Text="Temă" Margin="0,0,0,6" FontSize="11" Foreground="Gray" />
                <RadioButton x:Name="ThemeSystemRadio" Content="Sistem" GroupName="Theme" Margin="0,0,0,4" Checked="OnThemeChanged" />
                <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Theme" Margin="0,0,0,4" Checked="OnThemeChanged" />
                <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Theme" Checked="OnThemeChanged" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Mărime text" IsExpanded="True" Margin="0,0,0,12">
            <StackPanel Margin="4">
                <ComboBox x:Name="TextScaleCombo" SelectionChanged="OnTextScaleChanged">
                    <ComboBoxItem Content="Mic" Tag="Small" />
                    <ComboBoxItem Content="Normal" Tag="Normal" />
                    <ComboBoxItem Content="Mare" Tag="Large" />
                    <ComboBoxItem Content="Foarte mare" Tag="XLarge" />
                </ComboBox>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Header="Ajutor" IsExpanded="True" Margin="0,0,0,16">
            <StackPanel Margin="4">
                <TextBlock Text="Ghid de utilizare complet — instalare, licențiere, export/import, asset-uri cumpărate — în Română, English și Español."
                           TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,8" />
                <ui:Button Content="Deschide Ghidul de Utilizare (PDF)" Click="OnOpenHelpClicked" />
            </StackPanel>
        </ui:CardExpander>

        <ui:Button Content="Închide" HorizontalAlignment="Right" Click="OnCloseClicked" />
    </StackPanel>
    </Grid>
</ui:FluentWindow>
