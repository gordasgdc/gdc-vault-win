<UserControl x:Class="GDCVault.Client.EntryDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
      Fisa UNIFICATA a unui produs - credentiale, licentiere si resurse pe
      ACEEASI fisa, simultan (nu un tip exclusiv ales dintr-un dropdown -
      vezi nota de arhitectura 2026-08-24 din VaultEntry.cs). Randata
      direct in panoul de detaliu al MainWindow, nu intr-o fereastra
      modala separata.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <ui:TextBox x:Name="NameBox" FontSize="20" FontWeight="Bold"
                        PlaceholderText="Nume aplicație/produs (ex. Adobe Creative Cloud)"
                        Margin="0,0,0,16" />

            <ui:CardExpander Header="Credențiale" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <TextBlock Text="URL login" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="LoginUrlBox" Margin="0,0,0,8" />
                    <TextBlock Text="Utilizator" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,8" />
                    <TextBlock Text="Parolă" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordBoxChanged" />
                            <ui:TextBox x:Name="PasswordRevealBox" Visibility="Collapsed" TextChanged="OnPasswordRevealChanged" />
                        </Grid>
                        <ui:Button Grid.Column="1" x:Name="PasswordEyeButton" Content="👁" Margin="4,0,0,0" Click="OnTogglePasswordReveal" ToolTip="Arată/Ascunde" />
                        <ui:Button Grid.Column="2" Content="Copiază" Margin="4,0,0,0" Click="OnCopyPasswordClicked" />
                    </Grid>

                    <!-- Conturi/departamente suplimentare (2026-08-27) -
                         un produs poate avea mai multe conturi de login
                         (ex. Departament Video vs. Facturare). -->
                    <ItemsControl x:Name="AdditionalLoginsItemsControl" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="🗑" Padding="6,0" Margin="4,0,0,0"
                                                       Click="OnRemoveAdditionalLoginClicked" Tag="{Binding}" />
                                            <ui:TextBox PlaceholderText="Etichetă (ex. Departament Video)"
                                                        Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="URL login"
                                                    Text="{Binding LoginUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="Utilizator"
                                                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:TextBox PlaceholderText="Parolă"
                                                    Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="+ Adaugă alt cont/departament" Click="OnAddAdditionalLoginClicked" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Header="Licențiere" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <TextBlock Text="Tip" Margin="0,0,0,4" />
                    <ComboBox x:Name="LicenseTypeCombo" Margin="0,0,0,8" />
                    <CheckBox x:Name="HasExpiryCheck" Content="Are dată de expirare" Checked="OnExpiryToggled" Unchecked="OnExpiryToggled" Margin="0,0,0,6" />
                    <DatePicker x:Name="ExpiryPicker" Margin="0,0,0,8" />
                    <TextBlock Text="Cheie de serie" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="SerialBox" PasswordChanged="OnSerialBoxChanged" />
                            <ui:TextBox x:Name="SerialRevealBox" Visibility="Collapsed" TextChanged="OnSerialRevealChanged" />
                        </Grid>
                        <ui:Button Grid.Column="1" x:Name="SerialEyeButton" Content="👁" Margin="4,0,0,0" Click="OnToggleSerialReveal" ToolTip="Arată/Ascunde" />
                        <ui:Button Grid.Column="2" Content="Copiază" Margin="4,0,0,0" Click="OnCopySerialClicked" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Header="Resurse" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <TextBlock Text="Link descărcare" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="DownloadUrlBox" Margin="0,0,0,8" />
                    <TextBlock Text="Link actualizări" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="UpdateUrlBox" Margin="0,0,0,8" />
                    <TextBlock Text="Notițe" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="NotesBox" AcceptsReturn="True" MinHeight="110" MaxHeight="220"
                                TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsTab="True" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Header="Asset-uri cumpărate &amp; foldere locale" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel Margin="4">
                    <ItemsControl x:Name="AssetsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="🗑" Padding="6,0" Margin="4,0,0,0"
                                                       Click="OnRemoveAssetClicked" Tag="{Binding}" />
                                            <ui:TextBox PlaceholderText="Nume asset/pachet (ex. Cinematic SFX Vol 1)"
                                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="Deschide Folder" Margin="4,0,0,0"
                                                       Click="OnOpenAssetFolderClicked" Tag="{Binding}" />
                                            <ui:Button DockPanel.Dock="Right" Content="Selectează Folder…" Margin="4,0,0,0"
                                                       Click="OnPickAssetFolderClicked" Tag="{Binding}" />
                                            <ui:TextBox PlaceholderText="Cale folder local"
                                                        Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Margin="0,0,4,0" PlaceholderText="Serie/licență pachet"
                                                        Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:TextBox Grid.Column="1" Margin="4,0,0,0" PlaceholderText="Link descărcare"
                                                        Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="+ Adaugă alt asset/efect" Click="OnAddAssetClicked" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Header="Atașamente (contracte, facturi, screenshot-uri)" IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="4">
                    <ListBox x:Name="AttachmentsList" Height="70" Margin="0,0,0,4" MouseDoubleClick="OnAttachmentDoubleClick" />
                    <DockPanel>
                        <ui:Button Content="Șterge atașament" Click="OnRemoveAttachmentClicked" DockPanel.Dock="Right" />
                        <ui:Button Content="Adaugă fișier…" Click="OnAddAttachmentClicked" />
                    </DockPanel>
                </StackPanel>
            </ui:CardExpander>

            <DockPanel>
                <ui:Button x:Name="DeleteButton" Content="Șterge aplicația" Appearance="Danger" Click="OnDeleteClicked" />
                <ui:Button x:Name="CancelButton" Content="Anulează" Click="OnCancelClicked" Visibility="Collapsed" />
                <ui:Button Content="Salvează" Appearance="Primary" Click="OnSaveClicked"
                           HorizontalAlignment="Right" DockPanel.Dock="Right" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
